# Local Rancher Desktop — values are read by docker compose --env-file.
# Image tags here mirror deploy/envs/local/versions.yaml.
BACKEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-backend:c4095b335d3a
FRONTEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-frontend:c4095b335d3a

BACKEND_PORT=8080
FRONTEND_PORT=4200

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

JWT_SECRET=portfolio-local-dev-secret-key-rancher
ADMIN_USERNAME=admin
# $$ → $ après interpolation YAML (BCrypt contient des $ qui seraient autrement expandés)
ADMIN_PASSWORD_HASH=$$2b$$10$$ylcY5PaYQeX8u3/tuDdSi.awSBx1KQ8ztLAyRTO6lOnqxPFzZUHZm
