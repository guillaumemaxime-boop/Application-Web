# Local Rancher Desktop — values are read by docker compose --env-file.
# Image tags here mirror deploy/envs/local/versions.yaml.
BACKEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-backend:6646fa9df28b
FRONTEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-frontend:6646fa9df28b

BACKEND_PORT=8080
FRONTEND_PORT=4200

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

JWT_SECRET=portfolio-local-dev-secret-key-rancher
ADMIN_USERNAME=admin
# $$ → $ après interpolation YAML (BCrypt contient des $ qui seraient autrement expandés)
ADMIN_PASSWORD_HASH=$$2b$$10$$ylcY5PaYQeX8u3/tuDdSi.awSBx1KQ8ztLAyRTO6lOnqxPFzZUHZm

# --- Umami analytics ---
UMAMI_VERSION=postgresql-v2.13.0
UMAMI_APP_SECRET=umami-rancher-local-secret-change-me-min-32-chars
# Renseigner apres la creation initiale dans l'UI Umami :
UMAMI_WEBSITE_ID=
UMAMI_SHARE_TOKEN=

RESEND_API_KEY=
