# Modele pour deploy/envs/local/.env
# Copier ce fichier en .env et remplir les valeurs sensibles depuis le secret manager.
# NE PAS commiter de valeur reelle dans .env (cf. audit securite, finding F-05).
#
# Procedure :
#   1) cp deploy/envs/local/.env.example deploy/envs/local/.env
#   2) remplir les <<<...>>> avec les vraies valeurs (cf. coffre-fort partage)
#   3) NE PAS git add .env si vous y avez mis des secrets non destines a etre versionnes
#
# Pour rotation cle Resend : se connecter sur app.resend.com -> API Keys ->
# revoquer l'ancienne cle puis en generer une nouvelle. Remettre la nouvelle
# cle dans .env localement ET dans Railway env vars (deploy/envs/staging
# et deploy/envs/production) cote secrets GitHub Actions.

# --- Images Docker (cf. deploy/envs/local/versions.yaml) ---
BACKEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-backend:<<<sha>>>
FRONTEND_IMAGE=ghcr.io/guillaumemaxime-boop/portfolio-frontend:<<<sha>>>

BACKEND_PORT=8080
FRONTEND_PORT=4200

# --- Postgres ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# --- Auth admin ---
# JWT_SECRET doit faire >= 32 caracteres (HS256 = 256 bits).
JWT_SECRET=<<<remplir avec une chaine >= 32 caracteres>>>
ADMIN_USERNAME=admin
# Hash BCrypt (bcrypt-cli, htpasswd -B, ou via JBCrypt cote backend).
# $$ -> $ apres interpolation YAML (BCrypt contient des $ qui seraient sinon
# expandes par docker compose lors du parsing).
ADMIN_PASSWORD_HASH=<<<remplir avec un hash BCrypt $$2b$$10$$...>>>

# --- Umami analytics ---
UMAMI_VERSION=postgresql-v2.13.0
UMAMI_APP_SECRET=<<<remplir avec une chaine >= 32 caracteres>>>
# Renseigner apres la creation initiale dans l'UI Umami :
UMAMI_WEBSITE_ID=
UMAMI_SHARE_TOKEN=

# --- Email (Resend) ---
# Cle API Resend : https://app.resend.com -> API Keys.
# NE PAS commiter de vraie cle. La cle reside dans le secret manager.
RESEND_API_KEY=<<<remplir depuis app.resend.com>>>
