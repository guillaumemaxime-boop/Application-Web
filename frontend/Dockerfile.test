FROM node:20-bookworm

RUN apt-get update \
  && apt-get install -y chromium \
  && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium \
    CI=true

WORKDIR /workspace
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY . .

CMD ["npx", "ng", "test", "--watch=false"]
